<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RimWorld 1.7 runs on .NET 10 (Waylith CLR) instead of Mono / net472 -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VFEC_PerkToggle</AssemblyName>
    <RootNamespace>VFEC_PerkToggle</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Outputs straight into the mod 1.7 Assemblies folder so you never need to copy manually -->
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Source code is shared with the 1.6 project -->
  <ItemGroup>
    <Compile Include="..\PerkToggle.cs" />
  </ItemGroup>

  <!-- ── Adjust these paths for your machine ──────────────────────────────── -->
  <PropertyGroup>
    <!-- RimWorld install folder -->
    <RimWorldPath Condition="'$(RimWorldPath)'==''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
    <!-- Steam workshop content folder -->
    <RimWorldModPath Condition="'$(RimWorldModPath)'==''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</RimWorldModPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.7 core assemblies live at the game root (no more RimWorldWin64_Data\Managed) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.* is replaced by UnityStubs in 1.7 -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldPath)\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony (Harmony mod, workshop 2009463077) -->
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldModPath)\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Vanilla Expanded Framework (VEF) -->
    <Reference Include="VEF">
      <HintPath>$(RimWorldModPath)\2023507013\1.7\Assemblies\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- VFE Classical — no 1.7 folder: its LoadFolders.xml loads the 1.6 assembly for v1.7 -->
    <Reference Include="VFEC">
      <HintPath>$(RimWorldModPath)\2787850474\1.6\Assemblies\VFEC.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
